{
    "name": "danog/php-rtc-ntp",
    "type": "library",
    "description": "Pure-PHP NTP timestamp conversion for WebRTC. MadelineProto's PHP 8.2+ fork fixes unsigned 64-bit handling and integrates with the modular danog/php-rtc stack.",
    "keywords": [
        "multicastdns",
        "ntp"
    ],
    "homepage": "https://github.com/danog/php-rtc-ntp",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/polyfill-php83": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.3.2",
        "symfony/phpunit-bridge": "7.3.x-dev",
        "bamarni/composer-bin-plugin": "^1.9.1"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\NTP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\NTP\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
