{
    "name": "danog/php-rtc-ntp",
    "type": "library",
    "description": "Pure-PHP NTP timestamp conversion for WebRTC. MadelineProto's PHP 8.2+ fork fixes unsigned 64-bit handling and integrates with the modular danog/php-rtc stack.",
    "keywords": [
        "multicastdns",
        "ntp"
    ],
    "homepage": "https://github.com/danog/php-rtc-ntp",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "11.0.x-dev",
        "phpunit/phpunit": "^11.3",
        "symfony/phpunit-bridge": "7.3.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\NTP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\NTP\\": "tests"
        }
    },
    "minimum-stability": "dev"
}
