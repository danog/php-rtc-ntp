{
    "name": "danog/php-rtc-ntp",
    "type": "library",
    "description": "The NetworkTimeProtocol class provides utility methods for working with NTP (Network Time Protocol) timestamps in PHP. Fork with FFI made optional and a pure-PHP DTLS/SRTP stack, maintained for MadelineProto.",
    "keywords": [
        "multicastdns",
        "ntp"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-gmp": "*"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "11.0.x-dev",
        "phpunit/phpunit": "^11.3",
        "symfony/phpunit-bridge": "7.3.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\NTP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\NTP\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "replace": {
        "quasarstream/ntp": "self.version"
    }
}
